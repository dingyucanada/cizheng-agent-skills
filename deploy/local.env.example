# Copy to a PRIVATE environment file. Never commit actual credentials.
CIZHENG_MODEL_URL=http://127.0.0.1:8001/v1
CIZHENG_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Matching optional native service; set the actual local model directory privately.
CIZHENG_SPARK_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
CIZHENG_SPARK_PORT=8001
# CIZHENG_SPARK_MODEL_DIR=/absolute/path/to/verified/Qwen3-VL-8B-Instruct
CIZHENG_MODEL_REVISION=unverified
# Use the actual verified weight manifest; this example does not assert readiness.
CIZHENG_DISABLE_THINKING=0
# Host contracts retain action 2500 / vision 800 token caps and original budgets.
# Independent optional contracts; use only after their exact runtime is verified.
CIZHENG_STRUCTURED_OUTPUTS=0
CIZHENG_GUIDED_WORKFLOW=0
CIZHENG_COMPACT_ACTIONS=0
CIZHENG_DATA_DIR=data
# Optional public/approved-redacted TEXT critic only; leave key unset until supplied.
CIZHENG_STEPFUN_URL=https://api.stepfun.com/v1
# For a China Step Plan key, explicitly use https://api.stepfun.com/step_plan/v1.
# Do not append /chat/completions to the base URL; the client adds it once.
CIZHENG_STEPFUN_MODEL=step-3.7-flash
# CIZHENG_STEPFUN_KEY is supplied privately through the process environment.

# Optional offline NVIDIA NeMo Agent Toolkit interpreter, installed separately.
# Keep the venv path (do not resolve its Python symlink to a system interpreter).
# CIZHENG_NAT_PYTHON=/absolute/path/to/.nat/bin/python
